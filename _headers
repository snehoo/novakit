# Content-Security-Policy-Report-Only logs violations in the browser console
# and blocks nothing. Switch it to Content-Security-Policy once a week of
# browsing shows none.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://checkout.razorpay.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://aiservices-snehoo.duckdns.org https://cloudflareinsights.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://api.razorpay.com https://checkout.razorpay.com; form-action 'self' https://rzp.io https://razorpay.com https://api.razorpay.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self'

# Keep non-content assets and admin pages out of the index
/novakit-admin*
  X-Robots-Tag: noindex, nofollow
/kits-admin*
  X-Robots-Tag: noindex, nofollow
/feedback*
  X-Robots-Tag: noindex
/*.py
  X-Robots-Tag: noindex
/*.csv
  X-Robots-Tag: noindex
/*.xlsx
  X-Robots-Tag: noindex
/*.json
  X-Robots-Tag: noindex
